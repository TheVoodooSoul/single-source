cmd_brief() { curl -sS -H "$(ss_hdr)" "$SS_URL/brief"; }
cmd_tunnel() {
  # Public address for remote friends.
  # PERMANENT (2026-09-29): a named Cloudflare tunnel, "single-source", at
  # https://room.aktionfilmai.com — set up in ~/.cloudflared/config.yml. The
  # address never changes, so a seat link sent once works for good.
  # FALLBACK: if that config is missing, a quick tunnel with a random
  # *.trycloudflare.com address that changes on every start.
  command -v cloudflared >/dev/null || { echo "cloudflared not installed. Install with:  brew install cloudflared   (then re-run: bus tunnel)" >&2; exit 3; }
  if [[ -f "$HOME/.cloudflared/config.yml" ]] && grep -q "^tunnel:" "$HOME/.cloudflared/config.yml"; then
    local host; host="$(awk '/hostname:/{print $NF; exit}' "$HOME/.cloudflared/config.yml")"
    printf '{"url":"https://%s","at":"%s","permanent":true}\n' "$host" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$HERE/TUNNEL.json"
    echo "PUBLIC URL: https://$host   (permanent; leave this running)" >&2
    exec cloudflared tunnel --no-autoupdate run single-source
  fi
  echo "opening a temporary tunnel to $SS_URL … (leave this running; Ctrl-C closes the room to remote friends)" >&2
  cloudflared tunnel --url "$SS_URL" --no-autoupdate 2>&1 | while IFS= read -r line; do
    if [[ "$line" =~ (https://[a-z0-9-]+\.trycloudflare\.com) ]]; then
      printf '{"url":"%s","at":"%s"}\n' "${BASH_REMATCH[1]}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$HERE/TUNNEL.json"
      echo "PUBLIC URL: ${BASH_REMATCH[1]}   (saved to TUNNEL.json; invites now use it)"
    fi
  done
}

